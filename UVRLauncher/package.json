{
  "name": "uvr-launcher",
  "version": "1.0.0",
  "description": "NEXUS XR / UVR Universal VR Conversion Platform",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "serve": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.15.6",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "build": {
    "appId": "com.nexusxr.uvrlauncher",
    "productName": "UVR Launcher",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aswinbalaji780-afk",
        "repo": "VR_PRO",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "../VRModFramework/build/Release/dxgi.dll",
        "to": "dxgi.dll",
        "filter": ["**/*"]
      },
      {
        "from": "../VRModFramework/build/libVRMod.dylib",
        "to": "libVRMod.dylib",
        "filter": ["**/*"]
      },
      {
        "from": "../VRModFramework/vr_config.ini",
        "to": "vr_config.ini"
      }
    ]
  }
}
